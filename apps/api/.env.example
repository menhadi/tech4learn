HOST=127.0.0.1
PORT=3000
# Exact allowed admin origin; no trailing slash. No wildcard production origin.
ADMIN_ORIGIN=http://localhost:5173
# Optional absolute path to built admin assets for same-domain deployment.
# ADMIN_DIST_PATH=/home/tech4learn/tech4learn-app/apps/admin/dist
# Dedicated PostgreSQL database. Copy into .env and fill locally; never commit real credentials.
# DATABASE_URL=postgresql://USER:URL_ENCODED_PASSWORD@127.0.0.1:5432/tech4learn_app
# Run explicit migrations and bootstrap before exposing organisation services.
# Redis, media and ExamElite configuration will be added with those modules.
