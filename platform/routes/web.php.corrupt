Route::get('lang-swap/{locale}', function ($locale) {
    $allowed_locales = ['en', 'vi', 'hi']; 
    if (in_array($locale, $allowed_locales)) {
        session()->put('locale', $locale);
    }
    return redirect()->back();
})->name('lang.swap');


