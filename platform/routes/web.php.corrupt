Route::get('/check-time', function () {
    $configTimezone = \App\Models\Configuration::first()->timezone ?? 'Not Found in DB';
    
    return [
        '1. Database Timezone' => $configTimezone,
        '2. Laravel App Timezone' => config('app.timezone'),
        '3. Current Server Time' => now()->format('Y-m-d h:i:s A'),
    ];
});

Route::get('/debug-exams', function () {
    $student = \Illuminate\Support\Facades\Auth::guard('student')->user();
    if (!$student) {
        return "<h1>⚠️ Please Login as Student First!</h1> <p>Go to student login page, login, and then visit this URL again.</p>";
    }

    echo "<div style='font-family: sans-serif; padding: 20px;'>";
    echo "<h1>🕵️‍♂️ Exam Visibility Debugger</h1>";
    
    $config = \App\Models\Configuration::first();
    echo "<p><strong>Logged In Student:</strong> {$student->name} (ID: {$student->id})</p>";
    echo "<p><strong>System Timezone (DB):</strong> " . ($config->timezone ?? 'Not Set') . "</p>";
    echo "<p><strong>Laravel Timezone:</strong> " . config('app.timezone') . "</p>";
    echo "<p><strong>Current Server Time (Now):</strong> <span style='color:blue; font-weight:bold; font-size:18px;'>" . now()->format('Y-m-d H:i:s') . "</span></p>";
    echo "<hr>";

    $groupIds = \Illuminate\Support\Facades\DB::table('student_groups')->where('student_id', $student->id)->pluck('group_id');
    echo "<h3>1. Student Groups</h3>";
    if ($groupIds->isEmpty()) {
        echo "<p style='color:red'>❌ Student kisi bhi Group mein assigned nahi hai.</p>";
    } else {
        echo "<ul>";
        foreach ($groupIds as $gid) {
            $gname = \App\Models\Group::find($gid)->group_name ?? 'Unknown';
            echo "<li>Group ID: <strong>$gid</strong> ($gname)</li>";
        }
        echo "</ul>";
    }

    echo "<h3>2. Exam Status Check</h3>";
    $exams = \App\Models\Exam::latest()->get(); 

    echo "<table border='1' cellpadding='10' style='border-collapse:collapse; width:100%;'>";
    echo "<tr style='background:#f0f0f0; text-align:left;'>
            <th>ID</th>
            <th>Exam Name</th>
            <th>Assigned Groups</th>
            <th>Start Date</th>
            <th>End Date</th>
            <th>Status</th>
            <th>Result: Visible?</th>
          </tr>";

    foreach ($exams as $exam) {
        $examGroups = $exam->groups()->pluck('groups.id')->toArray();
        $hasCommonGroup = !empty(array_intersect($examGroups, $groupIds->toArray()));
        
        $now = now();
        $start = \Carbon\Carbon::parse($exam->start_date);
        $end = \Carbon\Carbon::parse($exam->end_date);
        
        $isStarted = $now->gte($start);
        $isNotExpired = $now->lte($end);
        $isActive = $exam->status === 'Active';

        $reasons = [];
        $isGreen = true;

        if (!$hasCommonGroup) { $reasons[] = "❌ Group Match Nahi Hua"; $isGreen = false; }
        if (!$isActive) { $reasons[] = "❌ Status Inactive Hai"; $isGreen = false; }
        if (!$isStarted) { $reasons[] = "❌ Abhi Shuru Nahi Hua (Future Date)"; $isGreen = false; }
        if (!$isNotExpired) { $reasons[] = "❌ Expire Ho Chuka Hai"; $isGreen = false; }

        if (empty($reasons)) {
            $statusText = "<span style='color:green; font-weight:bold'>✅ VISIBLE</span>";
        } else {
            $statusText = "<span style='color:red; font-weight:bold'>⛔ HIDDEN</span><br><small>" . implode('<br>', $reasons) . "</small>";
        }

        $rowColor = $isGreen ? '#e6fffa' : '#fff5f5';

        echo "<tr style='background:{$rowColor}'>";
        echo "<td>{$exam->id}</td>";
        echo "<td><strong>{$exam->name}</strong></td>";
        echo "<td>" . implode(', ', $examGroups) . "</td>";
        echo "<td>{$start->format('Y-m-d H:i:s')}</td>";
        echo "<td>{$end->format('Y-m-d H:i:s')}</td>";
        echo "<td>{$exam->status}</td>";
        echo "<td>{$statusText}</td>";
        echo "</tr>";
    }
    echo "</table></div>";
});
