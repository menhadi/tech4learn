    $package = \App\Models\Package::where('slug', $slug)->first();
    if ($package) {
        return redirect()->to('/course-detail/' . $package->id, 301);
    }
    abort(404);
})->where('slug', '^[a-z0-9-]+$');

// Guest exam guideline with slug -> redirect to ID
    $exam = \App\Models\Exam::where('slug', $slug)->first();
    if ($exam) {
        return redirect()->to('/guest/exam/guideline/' . $exam->id, 301);
    }
    abort(404);
})->where('slug', '^[a-z0-9-]+$');

