Route::get('/storage/{path}', function ($path) {
    $full = storage_path('app/public/' . $path);
    abort_unless(file_exists($full), 404);
    $mime = @mime_content_type($full) ?: 'application/octet-stream';
    return response()->file($full, [
        'Content-Type'  => $mime,
        'Cache-Control' => 'public, max-age=604800' 
    ]);
})->where('path', '.*');

Route::get('/test-smtp', function () {
    try {
        Illuminate\Support\Facades\Artisan::call('config:clear');
        config([
            'mail.default' => 'smtp',
            'mail.mailers.smtp.host' => 'smtp.hostinger.com',
            'mail.mailers.smtp.port' => 465,
            'mail.mailers.smtp.encryption' => 'ssl',
            'mail.mailers.smtp.username' => 'exam@eduexpression.com',
            'mail.mailers.smtp.password' => 'settingEmail@7272', 
            'mail.from.address' => 'exam@eduexpression.com',
            'mail.from.name' => 'Exam Frame Test',
        ]);
        Illuminate\Support\Facades\Mail::raw('Hostinger SMTP Working Successfully!', function ($msg) {
            $msg->to('exam@eduexpression.com')
                ->subject('Hostinger SMTP Success');
        });
        return "Hostinger Mail Sent Successfully! Check Inbox.";
    } catch (\Exception $e) {
        return "SMTP Error: " . $e->getMessage();
    }
});

