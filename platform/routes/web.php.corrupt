// Exam print with slug
Route::get('/exam-print/{id}', function ($slug) {
    $exam = App\Models\Exam::where('slug', $slug)->first();
    if ($exam) {
        return redirect()->to('/exam-print/' . $exam->id, 301);
    }
    abort(404);
})->where('slug', '^[a-z0-9-]+$');

