{
  "name": "tech4learn",
  "version": "0.1.0",
  "private": true,
  "workspaces": ["apps/*", "packages/*"],
  "engines": { "node": ">=24 <25" },
  "scripts": {
    "dev:api": "npm run dev --workspace @tech4learn/api",
    "dev:admin": "npm run dev --workspace @tech4learn/admin",
    "dev:mobile": "npm run start --workspace @tech4learn/mobile",
    "build": "npm run build --workspace @tech4learn/api && npm run build --workspace @tech4learn/admin",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspace @tech4learn/api",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "devDependencies": { "typescript": "~6.0.3", "@types/node": "^24.0.0" },
  "overrides": { "@nestjs/platform-express": { "multer": "2.3.0" } }
}
