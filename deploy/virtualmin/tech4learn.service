[Unit]
Description=Tech4Learn API and initial admin shell
After=network.target

[Service]
Type=simple
User=tech4learn
Group=tech4learn
WorkingDirectory=/home/tech4learn/tech4learn-app/apps/api
EnvironmentFile=/etc/tech4learn/api.env
ExecStart=/opt/tech4learn/node-v24.19.0/bin/node dist/main.js
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
UMask=0077

[Install]
WantedBy=multi-user.target
